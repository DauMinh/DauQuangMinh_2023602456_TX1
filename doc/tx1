HƯỚNG DẪN: 
1. Chuẩn bị cấu trúc dự án cho Docker & Kubernetes 
Trước khi cấu hình CI/CD, dự án Spring Boot của bạn cần có sẵn các tệp cấu hình 
đóng gói sau tại thư mục gốc của repository: 
A. Tệp Dockerfile (Đóng gói ứng dụng thành Image) 
Tạo tệp Dockerfile ở thư mục gốc: 
Dockerfile 
# Sử dụng OpenJDK 17 làm môi trường chạy 
FROM eclipse-temurin:17-jre-jammy 
# Thiết lập thư mục làm việc 
WORKDIR /app 
# Sao chép tệp JAR đã build vào container 
COPY target/*.jar app.jar 
# Mở cổng 8080 
EXPOSE 8080 
# Chạy ứng dụng Spring Boot 
ENTRYPOINT ["java", "-jar", "app.jar"] 
B. Tệp docker-compose.yml (Chạy thử nghiệm cục bộ) 
Tạo tệp docker-compose.yml để kiểm thử dịch vụ gồm ứng dụng và MySQL: 
YAML 
version: '3.8' 
services: 
mysql-db: 
image: mysql:8.0 
container_name: shop_mysql 
environment: 
MYSQL_ROOT_PASSWORD: rootpassword 
MYSQL_DATABASE: shop_management 
ports: - "3306:3306" 
volumes: - mysql_data:/var/lib/mysql 
networks: - shop-net 
shop-app: 
build: . 
container_name: shop_app 
ports: - "8080:8080" 
environment: 
- 
SPRING_DATASOURCE_URL=jdbc:mysql://mysql
db:3306/shop_management?useSSL=false&serverTimezone=UTC - SPRING_DATASOURCE_USERNAME=root - SPRING_DATASOURCE_PASSWORD=rootpassword - SPRING_JPA_HIBERNATE_DDL_AUTO=update 
depends_on: - mysql-db 
networks: - shop-net 
volumes: 
mysql_data: 
networks: 
shop-net: 
driver: bridge 
